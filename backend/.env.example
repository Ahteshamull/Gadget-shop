# ============================================================
# Gadgets POS - Shop Instance Configuration
# প্রতিটি নতুন দোকানের জন্য এই ফাইলটি কপি করে .env নামে সেভ করুন
# ============================================================

# সার্ভার পোর্ট (প্রতিটি দোকানের জন্য আলাদা পোর্ট, যেমন: 5000, 5001, 5002...)
PORT=5000
NODE_ENV=development

# ডেটাবেস সংযোগ (প্রতিটি দোকানের জন্য আলাদা ডেটাবেস নাম দিন, যেমন: phone_pos_shop1)
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/phone_pos_shop1?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/phone_pos_shop1

# সিকিউরিটি টোকেন কি (প্রতিটি দোকানের জন্য অনন্য ও গোপন স্ট্রিং দিন)
JWT_SECRET=replace-with-a-very-secure-24-character-secret
JWT_EXPIRES_IN=30d

# ফ্রন্টএন্ড সংযোগ (অনুমোদিত ফ্রন্টএন্ড ডোমেন/URL)
CORS_ORIGIN=http://localhost:5173,https://shop1.yourdomain.com

# প্রাথমিক অ্যাডমিন/ওনার অ্যাকাউন্ট (অপশনাল - ফাঁকা রাখলে প্রথমবার ব্রাউজারে ফর্ম আসবে)
DEFAULT_ADMIN_NAME=Shop Owner
DEFAULT_ADMIN_EMAIL=owner@shop1.com
DEFAULT_ADMIN_PASSWORD=change_this_password123

# ইমেইল নোটিফিকেশন সেটিংস (অপশনাল - পাসওয়ার্ড রিসেটের জন্য জিমেইল বা অন্য SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_CONTACT_EMAIL=owner@shop1.com
